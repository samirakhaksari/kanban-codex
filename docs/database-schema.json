{
  "schema_version": 2,
  "storage_engine": "SQLite",
  "required_pragmas": [
    "PRAGMA foreign_keys = ON"
  ],
  "tables": [
    {
      "name": "users",
      "purpose": "Data owner; MVP seeds one demo user and stores no password.",
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "username": "TEXT NOT NULL UNIQUE",
        "created_at": "TEXT NOT NULL, UTC ISO-8601"
      },
      "constraints": [],
      "foreign_keys": []
    },
    {
      "name": "user_profiles",
      "purpose": "Signed-in account display name and optional bounded raster avatar; independent of sample team members and login credentials.",
      "columns": {
        "user_id": "TEXT PRIMARY KEY",
        "first_name": "TEXT NOT NULL DEFAULT ''",
        "last_name": "TEXT NOT NULL DEFAULT ''",
        "avatar_data_url": "TEXT NULL"
      },
      "constraints": [],
      "foreign_keys": [
        {
          "from": [
            "user_id"
          ],
          "to": {
            "table": "users",
            "columns": [
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "boards",
      "purpose": "One board per user.",
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "owner_user_id": "TEXT NOT NULL",
        "created_at": "TEXT NOT NULL, UTC ISO-8601",
        "updated_at": "TEXT NOT NULL, UTC ISO-8601"
      },
      "constraints": [
        "UNIQUE(owner_user_id)",
        "UNIQUE(owner_user_id, id)"
      ],
      "foreign_keys": [
        {
          "from": [
            "owner_user_id"
          ],
          "to": {
            "table": "users",
            "columns": [
              "id"
            ]
          },
          "on_delete": "RESTRICT"
        }
      ]
    },
    {
      "name": "board_columns",
      "purpose": "Ordered columns belonging to a board.",
      "columns": {
        "id": "TEXT NOT NULL",
        "board_id": "TEXT NOT NULL",
        "title": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)"
      },
      "constraints": [
        "PRIMARY KEY(board_id, id)",
        "UNIQUE(board_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "board_id"
          ],
          "to": {
            "table": "boards",
            "columns": [
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "cards",
      "purpose": "Ordered cards and their scalar fields. Composite column key prevents cross-board references.",
      "columns": {
        "id": "TEXT NOT NULL",
        "board_id": "TEXT NOT NULL",
        "column_id": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)",
        "title": "TEXT NOT NULL",
        "details": "TEXT NOT NULL DEFAULT ''",
        "priority": "TEXT NULL CHECK(priority IS NULL OR priority IN ('low','medium','high'))",
        "due_date": "TEXT NULL, ISO date YYYY-MM-DD",
        "created_at": "TEXT NOT NULL, UTC ISO-8601",
        "updated_at": "TEXT NOT NULL, UTC ISO-8601"
      },
      "constraints": [
        "PRIMARY KEY(board_id, id)",
        "UNIQUE(board_id, column_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "board_id"
          ],
          "to": {
            "table": "boards",
            "columns": [
              "id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "from": [
            "board_id",
            "column_id"
          ],
          "to": {
            "table": "board_columns",
            "columns": [
              "board_id",
              "id"
            ]
          },
          "on_delete": "RESTRICT"
        }
      ]
    },
    {
      "name": "card_labels",
      "purpose": "Ordered free-form label strings; duplicate text is allowed.",
      "columns": {
        "card_id": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)",
        "label": "TEXT NOT NULL",
        "board_id": "TEXT NOT NULL"
      },
      "constraints": [
        "PRIMARY KEY(board_id, card_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "board_id",
            "card_id"
          ],
          "to": {
            "table": "cards",
            "columns": [
              "board_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "checklist_items",
      "purpose": "Ordered checklist entries belonging to a card.",
      "columns": {
        "id": "TEXT NOT NULL",
        "card_id": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)",
        "text": "TEXT NOT NULL",
        "done": "INTEGER NOT NULL CHECK(done IN (0,1))",
        "board_id": "TEXT NOT NULL"
      },
      "constraints": [
        "PRIMARY KEY(board_id, card_id, id)",
        "UNIQUE(board_id, card_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "board_id",
            "card_id"
          ],
          "to": {
            "table": "cards",
            "columns": [
              "board_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "teams",
      "purpose": "Ordered teams owned by one user.",
      "columns": {
        "id": "TEXT NOT NULL",
        "owner_user_id": "TEXT NOT NULL",
        "name_fa": "TEXT NOT NULL",
        "name_en": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)"
      },
      "constraints": [
        "PRIMARY KEY(owner_user_id, id)",
        "UNIQUE(owner_user_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "owner_user_id"
          ],
          "to": {
            "table": "users",
            "columns": [
              "id"
            ]
          },
          "on_delete": "RESTRICT"
        }
      ]
    },
    {
      "name": "team_members",
      "purpose": "Ordered members in a user's directory; a member may belong to several teams.",
      "columns": {
        "id": "TEXT NOT NULL",
        "owner_user_id": "TEXT NOT NULL",
        "name_fa": "TEXT NOT NULL",
        "name_en": "TEXT NOT NULL",
        "color": "TEXT NOT NULL, six-digit hexadecimal",
        "gender": "TEXT NOT NULL CHECK(gender IN ('female','male'))",
        "position": "INTEGER NOT NULL CHECK(position >= 0)"
      },
      "constraints": [
        "PRIMARY KEY(owner_user_id, id)",
        "UNIQUE(owner_user_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "owner_user_id"
          ],
          "to": {
            "table": "users",
            "columns": [
              "id"
            ]
          },
          "on_delete": "RESTRICT"
        }
      ]
    },
    {
      "name": "team_memberships",
      "purpose": "Many-to-many team/member relation with order within each team.",
      "columns": {
        "owner_user_id": "TEXT NOT NULL",
        "team_id": "TEXT NOT NULL",
        "member_id": "TEXT NOT NULL",
        "position": "INTEGER NOT NULL CHECK(position >= 0)"
      },
      "constraints": [
        "PRIMARY KEY(owner_user_id, team_id, member_id)",
        "UNIQUE(owner_user_id, team_id, position)"
      ],
      "foreign_keys": [
        {
          "from": [
            "owner_user_id",
            "team_id"
          ],
          "to": {
            "table": "teams",
            "columns": [
              "owner_user_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "from": [
            "owner_user_id",
            "member_id"
          ],
          "to": {
            "table": "team_members",
            "columns": [
              "owner_user_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "card_assignees",
      "purpose": "Many-to-many card/member relation, constrained to the same board owner.",
      "columns": {
        "owner_user_id": "TEXT NOT NULL",
        "board_id": "TEXT NOT NULL",
        "card_id": "TEXT NOT NULL",
        "member_id": "TEXT NOT NULL"
      },
      "constraints": [
        "PRIMARY KEY(board_id, card_id, member_id)"
      ],
      "foreign_keys": [
        {
          "from": [
            "owner_user_id",
            "board_id"
          ],
          "to": {
            "table": "boards",
            "columns": [
              "owner_user_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "from": [
            "board_id",
            "card_id"
          ],
          "to": {
            "table": "cards",
            "columns": [
              "board_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "from": [
            "owner_user_id",
            "member_id"
          ],
          "to": {
            "table": "team_members",
            "columns": [
              "owner_user_id",
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    },
    {
      "name": "user_data_migrations",
      "purpose": "One-time initialization/import marker; prevents a later browser from overwriting canonical data.",
      "columns": {
        "user_id": "TEXT NOT NULL",
        "migration_key": "TEXT NOT NULL",
        "source": "TEXT NOT NULL CHECK(source IN ('localStorage-v1','sample-seed'))",
        "completed_at": "TEXT NOT NULL, UTC ISO-8601"
      },
      "constraints": [
        "PRIMARY KEY(user_id, migration_key)"
      ],
      "foreign_keys": [
        {
          "from": [
            "user_id"
          ],
          "to": {
            "table": "users",
            "columns": [
              "id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ]
    }
  ],
  "indexes": [
    {
      "name": "idx_team_memberships_member",
      "table": "team_memberships",
      "columns": [
        "owner_user_id",
        "member_id"
      ]
    },
    {
      "name": "idx_card_assignees_member",
      "table": "card_assignees",
      "columns": [
        "owner_user_id",
        "member_id"
      ]
    }
  ],
