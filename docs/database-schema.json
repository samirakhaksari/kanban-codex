  "legacy_localstorage_migration": {
    "migration_key": "localStorage-v1",
    "source_keys": [
      "kanban-codex.board.v1",
      "kanban-codex.teams.v1"
    ],
    "policy": "Import the first signed-in browser's valid saved state once. A missing key uses the corresponding sample data; if both are missing, seed the full sample.",
    "validation": "Validate BoardState and TeamDirectory shapes and cross-check board columns, team memberships, and card assignees.",
    "atomicity": "Write the board, child records, team directory, assignments, and migration marker in one transaction.",
    "idempotency": "A completed user_data_migrations row prevents re-import and overwrite.",
    "invalid_data": "Reject without writing a marker or partial data; keep the browser values intact for retry or an explicit sample choice.",
    "shared_demo_account_limit": "The demo account is shared. The first valid browser state wins; other browsers' localStorage is not automatically merged."
  },
  "initialization_order": "At application startup, create the SQLite schema and demo user only. The first normal board read seeds sample data if there is no imported or existing board. Phase 7 browser import must run before the first normal board read."
}
